# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Env
.venv/
.env
*.local

# Caliper run artifacts (generated meshes, reports, render images)
runs/
# generated by `caliper insert --save` (points at a local run dir, not portable)
examples/inserted.yaml
*.stl
*.step
*.png
!tests/fixtures/**/*.stl   # keep checked-in test fixtures
!examples/*.stl            # keep checked-in demo references (e.g. the fit obstacle)
!examples/**/*.stl

# OS / editor
.DS_Store
.idea/
.vscode/

# local Claude config (machine-specific paths)
.claude/launch.json
.claude/settings.local.json

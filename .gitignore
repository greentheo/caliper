# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Env
.venv/
.env
*.local

# Caliper run artifacts (generated meshes, reports, render images)
runs/
# Caliper designs (CALI-28) — a user's in-progress designs, not repo content
designs/
# generated by insert (`caliper insert --save` / webapp /api/insert) — point at local run dirs
examples/inserted.yaml
examples/*.inserted.yaml
*.stl
*.step
*.png
!tests/fixtures/**/*.stl   # keep checked-in test fixtures
!examples/*.stl            # keep checked-in demo references (e.g. the fit obstacle)
!examples/**/*.stl
# the sample designs ship whole (CALI-59)
!src/caliper/samples/**/*.stl
!src/caliper/samples/**/*.png

# the optional tools `make tools` fetches (unfold-to-sheets)
vendor/

# OS / editor
.DS_Store
.idea/
.vscode/

# local Claude config (machine-specific paths)
.claude/launch.json
.claude/settings.local.json

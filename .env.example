# Copy to `.env` (gitignored) and fill in. The CLI auto-loads `.env` from the cwd or repo root.
# Only needed for the LLM intake/refine paths; the offline (--no-llm) paths need nothing.

# Your Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model id the LLM paths use (default: claude-opus-4-8).
# CALIPER_MODEL=claude-opus-4-8

# Optional: set to 1 to print why an LLM path fell back to offline.
# CALIPER_DEBUG=1
